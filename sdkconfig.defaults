CONFIG_IDF_TARGET="esp32s3"

# 1 ms Tick fuer saubere 8-ms-Sendeintervalle
CONFIG_FREERTOS_HZ=1000

# Bluetooth LE (Bluedroid) fuer esp_hid
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_BLE_SMP_ENABLE=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# GPIO19/20 gehoeren dem USB-Host: Konsole ueber UART, nicht ueber USB-Serial-JTAG
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Optional zum Stromsparen (erst testen, ob USB + BLE stabil bleiben):
# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
# 80 - 78mA, default - 79 mA
